# ==============================================================================
# HookLab Environment Configuration
# ==============================================================================
# Server-only variables. NEVER prefix secrets with VITE_ to keep them private.

# Upstash Redis REST Credentials (Required for persistent storage on Vercel)
# Obtain from https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-database-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Alternative standard Redis URL (if self-hosting standard Redis)
# REDIS_URL="redis://default:password@your-redis-host:6379"

# Rate Limiting (Requests per minute allowed per endpoint / client IP)
RATE_LIMIT_PER_MINUTE="120"

# Allow in-memory ephemeral fallback in development environments
ALLOW_EPHEMERAL_DEV_STORAGE="true"

# Server Port (default 3000)
PORT="3000"
